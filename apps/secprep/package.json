{
  "name": "secprep-daily",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Security+ (SY0-701) exam practice in English, French and Haitian Creole",
  "scripts": {
    "sync": "npx cap sync",
    "build:web": "node scripts/build-single.js",
    "check": "node scripts/check-data.js",
    "assets": "npx @capacitor/assets generate --ios --android --iconBackgroundColor \"#0d1f57\" --iconBackgroundColorDark \"#050a1c\" --splashBackgroundColor \"#0d1f57\" --splashBackgroundColorDark \"#050a1c\" && node scripts/ios-icon-appearances.js",
    "vendor:ionic": "rm -rf www/lib/ionic && mkdir -p www/lib/ionic && cp -r node_modules/@ionic/core/dist/ionic/. www/lib/ionic/ && cp node_modules/@ionic/core/css/ionic.bundle.css node_modules/@ionic/core/css/palettes/dark.class.css www/lib/ionic/",
    "build:content": "node scripts/check-data.js && node scripts/build-content.js",
    "audio": "node scripts/generate-audio.js"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@ionic/core": "^9.0.10"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
